{
  "manifest_version": 3,
  "name": "Color Developer Tools",
  "version": "1.0.0",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": { "default_popup": "popup/index.html" },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
